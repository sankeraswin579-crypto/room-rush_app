{
  "name": "room-rush-desktop",
  "version": "1.0.4",
  "description": "Room Rush real-time multiplayer trivia game for desktop and browser",
  "main": "electron/main.js",
  "author": "Aswin Sankar P S",
  "license": "MIT",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "build:win": "electron-builder --win portable --config.directories.output=release-portable",
    "test": "node --test"
  },
  "dependencies": {
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "socket.io-client": "^4.8.4"
  },
  "build": {
    "appId": "com.aswinsankar.roomrush",
    "productName": "Room Rush",
    "directories": {
      "output": "release-portable"
    },
    "files": [
      "electron/**/*",
      "public/**/*",
      "server.js",
      "package.json"
    ],
    "win": {
      "target": "portable"
    }
  },
  "allowScripts": {
    "electron@45.2.3": true
  }
}
